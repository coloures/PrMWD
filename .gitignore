# --- Python / Jupyter ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env

# --- Данные (версии хранятся в DVC, а не в Git) ---
src/data/raw/**
!src/data/raw/**/
!src/data/raw/.gitignore
!src/data/raw/*.dvc

# --- Артефакты моделей и лишние файлы ---
*.joblib
*.pkl
*.log

# --- ЛР2: артефакты выполнения ноутбука (пересоздаются при запуске) ---
src/reports/figures/*
src/reports/*.csv
src/reports/*.json
